  "@type": "Person",
  "name": "Hari Moradiya",
  "alternateName": "Harikrushn Devjibhai Moradiya",
  "url": siteUrl,
  "image": `${siteUrl}/profilepic.jpeg`,
  "jobTitle": "Software Engineer",
  "description": "Software Engineer specializing in Android, iOS, and backend development. Creator of open-source Android TV remote control apps.",
  "knowsAbout": ["Android Development", "Kotlin", "Jetpack Compose", "Flutter", "Ktor", "PostgreSQL", "Open Source Software"],
  "sameAs": [
    "https://github.com/harimoradiya",
    "https://www.linkedin.com/in/hari-moradiya-0a7145179/",
    "https://twitter.com/hari_moradiya_"
