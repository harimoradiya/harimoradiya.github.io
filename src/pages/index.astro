---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featuredProjects = [
  {
    title: 'Android TV Remote',
    category: 'Android App',
    excerpt: 'Seamless, open-source TV remote control for Android devices with low-latency sockets and zero ads.',
    techStack: 'Kotlin, Native Android TV, Sockets',
    url: '/projects/android-tv-remote',
    specs: ['100% Free', 'Open Source', 'No Ads', 'No IAP'],
    featured: true,
  },
  {
    title: 'Wifi Remote for Android TV',
    category: 'iOS App',
    excerpt: 'Turn your iPhone or iPad into a powerful remote control for Android TV with trackpad gestures & keyboard input.',
    techStack: 'Flutter, iOS, WebSockets',
    url: '/projects/wifi-remote-ios',
    specs: ['Built with Flutter', 'Closed Source', 'Contains Ads', 'Offers IAP (Freemium)'],
    featured: true,
  },
  {
    title: 'RMS (Restaurant Management System)',
    category: 'Backend REST API',
    excerpt: 'High-throughput server-side REST API built with Kotlin Ktor, PostgreSQL, Exposed ORM, and Docker.',
    techStack: 'Kotlin, Ktor, PostgreSQL, Docker',
    url: 'https://github.com/harimoradiya/rms',
    specs: ['Open Source', 'Backend'],
    featured: false,
  },
  {
    title: 'WearOS Stopwatch',
    category: 'WearOS App',
    excerpt: 'Minimalist, battery-efficient lap timer and stopwatch application designed specifically for Wear OS smartwatches.',
    techStack: 'Kotlin, Jetpack Compose, Wear OS',
    url: 'https://github.com/harimoradiya/WearOS-Stopwatch',
    specs: ['100% Free', 'Open Source'],
    featured: false,
  },
  {
    title: 'Network Discovery Protocol',
    category: 'Android Library',
    excerpt: 'Automated mDNS & local network discovery utility to locate smart devices connected on local Wi-Fi.',
    techStack: 'Kotlin, Coroutines, Flow, NSD',
    url: 'https://github.com/harimoradiya/Network-Discovery',
    specs: ['Open Source'],
    featured: false,
  },
  {
    title: 'Background Remover App',
    category: 'Android & Computer Vision',
    excerpt: 'On-device image background segmentation app leveraging on-device ML vision processing.',
    techStack: 'Kotlin, ML Kit, OpenCV',
    url: 'https://github.com/harimoradiya/Background-Remover-App',
    specs: ['Open Source'],
    featured: false,
  },
];

const skills = [
  'Android Development',
  'Kotlin & Java',
  'Jetpack Compose',
  'Flutter (iOS/Android)',
  'Sockets & Network Protocols',
  'Ktor Backend',
  'Wear OS',
  'Material Design',
];

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/harimoradiya' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/hari-moradiya-0a7145179/' },
  { label: 'Twitter', href: 'https://twitter.com/hari_moradiya_' },
  { label: 'Resume', href: 'https://drive.google.com/file/d/1SljlOBLyZcYdaP7txqFoFNiKs2yxgxhx/view?usp=sharing' },
];
---

<Layout title="Hari Moradiya — Senior Android & Mobile Engineer">
  <!-- Hero Section -->
  <section class="py-6 sm:py-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-8 border-b border-zinc-200/80 dark:border-zinc-800/80">
      <div class="space-y-4 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/50">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Available for New Projects & Consultation</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
          Hi, I'm Hari Moradiya.
        </h1>

        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Senior Software Engineer specializing in <strong class="text-zinc-900 dark:text-zinc-100 font-semibold">Android, Flutter, and high-performance mobile systems</strong>. I build clean, ultra-responsive remote utilities, smart TV integrations, and backend services.
        </p>

        <!-- Social Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-medium bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800/70 dark:hover:bg-zinc-800 text-zinc-800 dark:text-zinc-200 transition-colors"
            >
              <span>{link.label}</span>
              <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Stack Summary -->
  <section class="py-6">
    <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-3">
      Core Expertise & Technologies
    </h2>
    <div class="flex flex-wrap gap-2">
      {skills.map((skill) => (
        <span class="px-3 py-1 rounded-lg text-xs font-mono font-medium bg-zinc-100 dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300">
          {skill}
        </span>
      ))}
    </div>
  </section>

  <!-- Projects Grid Section -->
  <section class="py-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Featured Applications & Projects
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
          Explore native mobile apps, open-source TV remote tools, and server architectures.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard
          title={project.title}
          category={project.category}
          excerpt={project.excerpt}
          techStack={project.techStack}
          url={project.url}
          specs={project.specs}
          featured={project.featured}
        />
      ))}
    </div>
  </section>
</Layout>