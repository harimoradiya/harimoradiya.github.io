---

<Layout
  title="Hari Moradiya | Android & iOS Software Engineer"
  description="Software Engineer specializing in building premium Android apps, open-source tools, and robust backend systems. Creator of TV Remote for Android TV — 1K+ downloads, 4.7★."
  jsonLd={jsonLd}
>
  <!-- ============================
       HERO SECTION
  ============================= -->
  <section class="hero-section" aria-label="Introduction">
    <div class="hero-layout">

      <!-- LEFT: Text content -->
      <div class="hero-content">
        <div class="hero-badge-row reveal">
          <span class="badge badge-success">
            <span class="status-dot"></span>
            Available for opportunities
          </span>
        </div>

        <h1 class="hero-title reveal" style="animation-delay:0.1s">
          Building <span class="gradient-text">Premium</span><br />
          Mobile Experiences
        </h1>

        <p class="hero-subtitle reveal" style="animation-delay:0.2s">
          I'm <strong>Hari Moradiya</strong> — Software Engineer focused on Android, iOS, and backend
          systems. I build fast, privacy-respecting apps used by thousands of people worldwide.
        </p>

        <div class="hero-actions reveal" style="animation-delay:0.3s">
          <a href={resumeLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" id="hero-resume-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            View Resume
          </a>
          <a href="mailto:harimoradiya123@gmail.com" class="btn btn-secondary btn-lg" id="hero-contact-btn">
            Get in Touch
          </a>
        </div>

        <div class="hero-socials reveal" style="animation-delay:0.4s">
          {socialLinks.map(link => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="social-pill" aria-label={link.name}>
              <svg viewBox="0 0 24 24" class="social-icon"><path d={link.icon} /></svg>
              <span>{link.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- RIGHT: Profile card -->
      <div class="hero-visual reveal-right">
        <div class="profile-card glass-card">
          <div class="profile-img-wrap">
            <Image
              src={profilePic}
              alt="Hari Moradiya - Software Engineer"
              width={200}
              height={200}
              class="profile-img"
              loading="eager"
            />
            <div class="profile-ring"></div>
          </div>
          <div class="profile-card-body">
            <h2 class="profile-name">Hari Moradiya</h2>
            <p class="profile-role">Software Engineer</p>
            <div class="profile-stats">
              <div class="pstat">
                <span class="pstat-value">4+</span>
                <span class="pstat-label">Years</span>
              </div>
              <div class="pstat-divider"></div>
              <div class="pstat">
                <span class="pstat-value">20+</span>
                <span class="pstat-label">Projects</span>
              </div>
              <div class="pstat-divider"></div>
              <div class="pstat">
                <span class="pstat-value">4.7★</span>
                <span class="pstat-label">Rating</span>
              </div>
            </div>
          </div>
          <!-- Floating accent badges -->
          <div class="float-badge float-badge-1">
            <span>📱</span> Android Dev
          </div>
          <div class="float-badge float-badge-2">
            <span>⭐</span> 50+ GitHub Stars
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================
       STATS BAR
  ============================= -->
  <section class="stats-bar reveal" aria-label="Key statistics">
    <div class="stats-inner stagger-children">
      <div class="stat-item">
        <span class="stat-num">4+</span>
        <span class="stat-label">Years building</span>
      </div>
      <div class="stat-sep" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-num">20+</span>
        <span class="stat-label">Products delivered</span>
      </div>
      <div class="stat-sep" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-num">1K+</span>
        <span class="stat-label">App downloads</span>
      </div>
      <div class="stat-sep" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-num">4.7★</span>
        <span class="stat-label">Average rating</span>
      </div>
      <div class="stat-sep" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-num">50+</span>
        <span class="stat-label">GitHub stars</span>
      </div>
    </div>
  </section>

  <!-- ============================
       PROJECTS SECTION
  ============================= -->
  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="section-header reveal">
      <span class="section-eyebrow">Works</span>
      <h2 class="section-title" id="projects-title">Featured Projects</h2>
      <p class="section-desc">Selected mobile applications and developer tools built with performance and intuitive UX in mind.</p>
    </div>

    <div class="projects-grid">
      {projects.map((project, i) => (
        <a
          href={project.url}
          class={`project-card card reveal ${project.featured ? 'featured' : ''}`}
          style={`animation-delay: ${i * 0.08}s`}
          target={project.external ? '_blank' : undefined}
          rel={project.external ? 'noopener noreferrer' : undefined}
          aria-label={`${project.title} - ${project.category}`}
        >
          <div class="pc-top">
            <div class="pc-meta">
              <span class="pc-icon" aria-hidden="true">{project.icon}</span>
              <div>
                <span class="pc-category" style={`color: ${colorMap[project.categoryColor] || 'var(--primary)'}`}>
                  {project.category}
                </span>
                {project.featured && <span class="badge badge-primary pc-featured-badge">Featured</span>}
              </div>
            </div>
            {project.external && (
              <svg class="pc-external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            )}
          </div>

          <h3 class="pc-title">{project.title}</h3>
          <p class="pc-excerpt">{project.excerpt}</p>

          <div class="pc-footer">
            <div class="pc-chips">
              {project.techStack.map(t => <span class="chip">{t}</span>)}
            </div>
            <span class="pc-cta">
              View <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="projects-cta reveal">
      <a href="https://github.com/harimoradiya" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" id="view-all-github-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        View all on GitHub
      </a>
    </div>
  </section>

  <!-- ============================
       SKILLS SECTION
  ============================= -->
  <section class="section" aria-labelledby="skills-title">
    <div class="section-header reveal">
      <span class="section-eyebrow">Expertise</span>
      <h2 class="section-title" id="skills-title">Tech Stack</h2>
      <p class="section-desc">Technologies I use to build production-quality, cross-platform software.</p>
    </div>

    <div class="skills-grid stagger-children">
      {skills.map(group => (
        <div class="skill-group card">
          <div class="skill-group-header">
            <span class="skill-group-icon" aria-hidden="true">{group.icon}</span>
            <h3 class="skill-group-name">{group.category}</h3>
          </div>
          <div class="skill-chips">
            {group.items.map(item => (
              <span class="chip chip-accent">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================
       EXPERIENCE SECTION
  ============================= -->
  <section class="section" aria-labelledby="experience-title">
    <div class="section-header reveal">
      <span class="section-eyebrow">Career</span>
      <h2 class="section-title" id="experience-title">Work Experience</h2>
    </div>

    <div class="timeline">
      <div class="timeline-track" aria-hidden="true"></div>
      {experiences.map((exp, i) => (
        <div class="timeline-item reveal" style={`animation-delay: ${i * 0.15}s`}>
          <div class="timeline-node" aria-hidden="true"></div>
          <div class="timeline-card card">
            <div class="tc-header">
              <div>
                <h3 class="tc-title">{exp.title}</h3>
                <p class="tc-company">{exp.company}</p>
              </div>
              <div class="tc-right">
                <span class="tc-period">{exp.period}</span>
                <span class="badge badge-primary tc-type">{exp.type}</span>
              </div>
            </div>
            <p class="tc-desc">{exp.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================
       CONTACT CTA SECTION
  ============================= -->
  <section class="contact-cta reveal" aria-labelledby="contact-title">
    <div class="cta-card glass-card">
      <div class="cta-glow" aria-hidden="true"></div>
      <span class="section-eyebrow">Let's Connect</span>
      <h2 class="cta-title" id="contact-title">Ready to Build Something<br /><span class="gradient-text">Premium Together?</span></h2>
      <p class="cta-desc">Whether you're looking for a skilled Android engineer, want to collaborate on open-source, or just want to say hello — my inbox is always open.</p>
      <div class="cta-actions">
        <a href="mailto:harimoradiya123@gmail.com" class="btn btn-primary btn-lg" id="contact-email-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          Send an Email
        </a>
        <a href="https://www.linkedin.com/in/hari-moradiya-0a7145179/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg" id="contact-linkedin-btn">
          Connect on LinkedIn
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============================
     HERO
  ============================= */
  .hero-section {
    padding: 2rem 0 5rem;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 4rem;
    align-items: center;
    min-height: 75vh;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .hero-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: var(--success);
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 0 2px var(--success-glow);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 2px var(--success-glow); }
    50% { box-shadow: 0 0 0 5px var(--success-glow); }
  }

  .hero-title {
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 540px;
  }

  .hero-subtitle strong {
    color: var(--text-primary);
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-socials {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .social-pill:hover {
    color: var(--primary);
    border-color: var(--primary);
    background: var(--primary-glow);
    transform: translateY(-2px);
  }

  .social-icon {
    width: 16px;
    height: 16px;
    fill: currentColor;
