---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import SectionCard from '../components/about/SectionCard.astro';
import { Image } from 'astro:assets';
import profilePic from '../assets/profilepic.jpeg';

const siteUrl = 'https://harimoradiya.github.io';

const highlights = [
  { label: 'Years Building', value: '4+' },
  { label: 'Products Delivered', value: '20+' },
  { label: 'Cross-Platform Releases', value: '10+' },
  { label: 'Avg App Rating', value: '4.8/5' },
];

const services = [
  'Android and iOS App Engineering',
  'Backend API Design and Integration',
  'Performance Optimization and Stability',
  'UI and UX Modernization',
];

const techStack = [
  'Kotlin',
  'Java',
  'Flutter',
  'Dart',
  'Ktor',
  'PostgreSQL',
  'Compose Multiplatform',
  'Material Design 3',
];

const journey = [
  { year: '2020', detail: 'Started shipping Android features with a user-first mindset, learning Kotlin and modern Android architecture.' },
  { year: '2022', detail: 'Joined product engineering at Vasuka and delivered production-grade Android applications.' },
  { year: '2024', detail: 'Expanded into backend APIs with Ktor and PostgreSQL, and released first open-source app to 1K+ users.' },
  { year: '2026', detail: 'Building polished cross-platform products with faster release cycles and growing open-source community.' },
];

const projects = [
  { name: 'TV Remote for Android TV', impact: '1K+ downloads, 4.7★ rating. Open-source Android TV remote control app. Zero ads, zero tracking.' },
  { name: 'Android TV Remote (iOS)', impact: 'Flutter-based iPhone remote for Android TV and Google TV. Clean Material Design interface.' },
  { name: 'WiFi Mouse Remote', impact: 'Low-latency computer control client built using Compose Multiplatform and Java Sockets.' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": "Hari Moradiya",
    "alternateName": "Harikrushn Devjibhai Moradiya",
    "url": siteUrl,
    "image": `${siteUrl}/profilepic.jpeg`,
    "jobTitle": "Software Engineer",
    "description": "Software Engineer specializing in Android, iOS, and backend development. 4+ years of experience building premium mobile applications.",
    "knowsAbout": ["Kotlin", "Jetpack Compose", "Flutter", "Ktor", "PostgreSQL", "Android TV"],
    "sameAs": [
      "https://github.com/harimoradiya",
      "https://www.linkedin.com/in/hari-moradiya-0a7145179/"
    ]
  }
};
---

<Layout
  title="About Hari Moradiya | Android & iOS Software Engineer"
  description="Learn about Hari Moradiya — a software engineer with 4+ years of experience building premium Android apps, iOS apps, and backend systems. Creator of TV Remote for Android TV."
  canonicalUrl={`${siteUrl}/about`}
  jsonLd={jsonLd}
>
  <div class="about-page">

    <!-- Hero -->
    <section class="about-hero">
      <div class="hero-glass glass-card">
        <div class="hero-inner">
          <div class="hero-photo-col reveal-left">
            <div class="about-photo-wrap">
              <Image
                src={profilePic}
                alt="Hari Moradiya - Software Engineer"
                width={200}
                height={200}
                class="about-photo"
                loading="eager"
              />
              <div class="photo-ring"></div>
            </div>
          </div>
          <div class="hero-text-col reveal">
            <span class="section-eyebrow">Profile</span>
            <h1 class="about-title">
              Harikrushn Devjibhai <span class="gradient-text">Moradiya</span>
            </h1>
            <p class="about-lead">
              I am a software engineer focused on building premium mobile and backend product experiences.
              I design reliable, elegant applications that are fast, secure, and production-ready —
              used by thousands of people worldwide.
            </p>
            <div class="hero-actions">
              <a href="mailto:harimoradiya123@gmail.com" class="btn btn-primary" id="about-contact-btn">
                Get in Touch
              </a>
              <a href="https://github.com/harimoradiya" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" id="about-github-btn">
                GitHub Profile
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Grid -->
    <section class="stats-grid-section reveal stagger-children" aria-label="Key statistics">
      {highlights.map(item => (
        <article class="stat-card card">
          <p class="stat-value">{item.value}</p>
          <p class="stat-label">{item.label}</p>
        </article>
      ))}
    </section>

    <!-- Core Grid -->
    <div class="about-sections-grid">
      <div class="reveal">
        <SectionCard title="Story" subtitle="Built with ownership, clarity, and consistency.">
          <p class="paragraph-spacing">
            I specialize in mobile app engineering and full product delivery, including robust backend services and cross-platform mobile clients.
            My development mindset centers around user trust, app speed, and clean code principles.
          </p>
          <p>
            I've shipped apps that are used daily by thousands of users across Android and iOS, and I actively maintain open-source projects on GitHub.
          </p>
        </SectionCard>
      </div>

      <div class="reveal">
        <SectionCard title="Experience Highlights" subtitle="Core areas where I consistently deliver value.">
          <ul class="highlights-list">
            <li>Production-ready app delivery using Kotlin, Flutter, and Material Design 3 standards.</li>
            <li>Backend REST API engineering with Kotlin Ktor, PostgreSQL, and Docker deployments.</li>
            <li>Open-source project maintenance with community-focused development practices.</li>
            <li>Continuous integration, automated testing, and device-specific quality workflows.</li>
          </ul>
        </SectionCard>
      </div>

      <div class="reveal">
        <SectionCard title="Mission">
          <p>
            Deliver software utilities that are highly responsive, simple to navigate, stable under load, and visually delightful across all platforms — while always respecting user privacy.
          </p>
        </SectionCard>
      </div>

      <div class="reveal">
        <SectionCard title="Vision">
          <p>
            Establish premium digital products where design quality, user privacy, and engineering reliability are equally prioritized. Open source as a default, ads as a last resort.
          </p>
        </SectionCard>
      </div>

      <div class="reveal">
        <SectionCard title="Services & Expertise">
          <div class="chips-container">
            {services.map(service => <span class="chip">{service}</span>)}
          </div>
        </SectionCard>
      </div>

      <div class="reveal">
        <SectionCard title="Core Tech Stack">
          <div class="chips-container">
            {techStack.map(tech => <span class="chip chip-accent">{tech}</span>)}
          </div>
        </SectionCard>
      </div>
    </div>

    <!-- Journey Timeline -->
    <section class="journey-section">
      <div class="reveal">
        <SectionCard title="Journey Timeline" subtitle="My professional trajectory over the years.">
          <div class="timeline-wrapper">
            <div class="timeline-line" aria-hidden="true"></div>
            {journey.map(step => (
              <div class="timeline-node-item">
                <div class="timeline-bullet" aria-hidden="true"></div>
                <div class="timeline-content">
                  <span class="timeline-year">{step.year}</span>
                  <p class="timeline-text">{step.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </SectionCard>
      </div>
    </section>

    <!-- Project Highlights -->
    <section class="about-projects">
      <div class="reveal">
        <SectionCard title="Key Projects & Outcomes" subtitle="Selected results from recent releases.">
          <div class="projects-mini-grid">
            {projects.map(project => (
              <div class="mini-project-card card">
                <h4>{project.name}</h4>
                <p>{project.impact}</p>
              </div>
            ))}
          </div>
        </SectionCard>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-bottom reveal">
      <div class="cta-card glass-card">
        <h2>Let's Build Something Premium Together</h2>
        <p>
          If you are looking for a reliable software engineer to deliver high-quality mobile apps or scalable backend systems,
          let's connect and build your next release.
        </p>
        <div class="cta-actions">
          <a href="mailto:harimoradiya123@gmail.com" class="btn btn-primary btn-lg" id="about-cta-email-btn">
            Send an Email
          </a>
          <a href="https://www.linkedin.com/in/hari-moradiya-0a7145179/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg" id="about-cta-linkedin-btn">
            Connect on LinkedIn
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-page {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Hero */
  .about-hero { padding-top: 0.5rem; }

  .hero-glass { padding: 0; overflow: hidden; }

  .hero-inner {
    padding: 3rem 3rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-photo-col {
    display: flex;
    justify-content: center;
  }

  .about-photo-wrap {
    position: relative;
    width: 160px;
    height: 160px;
    flex-shrink: 0;
  }

  .about-photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--primary);
    display: block;
  }

  .photo-ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px dashed var(--primary);
    opacity: 0.3;
    animation: spinSlow 20s linear infinite;
  }

  @keyframes spinSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .about-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0.5rem 0 1rem;
  }

  .about-lead {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 1.75rem;
    max-width: 620px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Stats */
  .stats-grid-section {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .stat-card {
    padding: 1.75rem 1.25rem;
    text-align: center;
  }

  .stat-value {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.35rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  /* Core grid */
  .about-sections-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .highlights-list {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--text-secondary);
  }

  .highlights-list li { line-height: 1.6; }

  .paragraph-spacing { margin-bottom: 1rem; color: var(--text-secondary); }

  .chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Journey timeline */
  .journey-section, .about-projects { width: 100%; }

  .timeline-wrapper {
    position: relative;
    padding: 0.5rem 0;
  }

  .timeline-line {
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border-color);
  }

  .timeline-node-item {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 1.75rem;
  }

  .timeline-node-item:last-child { margin-bottom: 0; }

  .timeline-bullet {
    position: absolute;
    left: 0;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg-surface);
    border: 3.5px solid var(--primary);
    z-index: 2;
  }

  .timeline-content {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .timeline-year {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--primary);
    min-width: 44px;
    padding-top: 2px;
  }

  .timeline-text {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 0.9rem;
  }

  /* Mini projects */
  .projects-mini-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .mini-project-card {
    padding: 1.25rem;
    border-radius: var(--radius-md);
  }

  .mini-project-card h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .mini-project-card p {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  /* CTA */
  .cta-bottom { padding-top: 1rem; }

  .cta-card {
    padding: 4rem 2.5rem;
    text-align: center;
  }

  .cta-card h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .cta-card p {
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 2rem;
    }

    .hero-photo-col { justify-content: center; }
    .hero-actions { justify-content: center; }

    .stats-grid-section { grid-template-columns: repeat(2, 1fr); }
    .about-sections-grid { grid-template-columns: 1fr; }
    .projects-mini-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .stats-grid-section { grid-template-columns: repeat(2, 1fr); }
    .timeline-content { flex-direction: column; gap: 0.25rem; }
    .cta-card { padding: 2.5rem 1.5rem; }
  }
</style>
