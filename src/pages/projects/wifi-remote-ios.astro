---
// src/pages/projects/wifi-remote-ios.astro
import Layout from '../../layouts/Layout.astro';
import SpecBadge from '../../components/SpecBadge.astro';
import PricingMatrix from '../../components/PricingMatrix.astro';

const specs = ['Built with Flutter', 'Closed Source', 'Contains Ads', 'Offers IAP (Freemium)'];

const appStoreUrl = 'https://apps.apple.com/us/app/wifi-remote-for-android-tv/id6763198238';

const highlights = [
  {
    title: 'Cross-Platform Flutter Engine',
    description: 'Engineered with Flutter for high performance, smooth 60 FPS touch gestures, and uniform iOS design system guidelines.',
  },
  {
    title: 'Multi-Touch Trackpad & Gestures',
    description: 'Includes smooth trackpad input with intuitive swipe gestures, tap-to-select, and momentum scrolling for Android TV interfaces.',
  },
  {
    title: 'Instant Keyboard Synchronizer',
    description: 'Eliminate tedious on-screen keyboard letter picking by typing directly from your iPhone or iPad keyboard with live synchronization.',
  },
  {
    title: 'Channel & App Quick Launcher',
    description: 'Launch Netflix, YouTube, Prime Video, and installed Android TV apps with a single tap directly from your iOS device screen.',
  },
];
---

<Layout
  title="Wifi Remote for Android TV (iOS) — Built with Flutter"
  description="iOS application to remotely control Android TV from iPhone and iPad devices. Built with Flutter, offering trackpad gestures, keyboard input, and Freemium tier."
>
  <div class="space-y-10">
    <!-- Back Button -->
    <div>
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
      >
        &larr; Back to Overview
      </a>
    </div>

    <!-- Header & Badge Section -->
    <div class="space-y-4 pb-8 border-b border-zinc-200/80 dark:border-zinc-800/80">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-md text-xs font-mono font-medium uppercase bg-sky-100 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300">
          iOS & iPadOS
        </span>
        {specs.map((spec) => (
          <SpecBadge spec={spec} />
        ))}
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100">
        Wifi Remote for Android TV
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 max-w-3xl leading-relaxed">
        A elegant, feature-rich iOS remote controller for Android TV and Google TV devices. Allows iPhone and iPad users to navigate TV apps with trackpad gestures, instant text typing, and quick app shortcuts.
      </p>

      <!-- App Store Badge Link -->
      <div class="flex flex-wrap items-center gap-3 pt-4">
        <a
          href={appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl font-medium text-sm bg-zinc-900 dark:bg-zinc-100 hover:bg-zinc-800 dark:hover:bg-zinc-200 text-zinc-100 dark:text-zinc-950 shadow-sm transition-all duration-200"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.85c.66-.8 1.11-1.92.99-3.04-.96.04-2.12.64-2.8 1.44-.61.71-1.14 1.86-1 2.98 1.07.08 2.15-.58 2.81-1.38z" />
          </svg>
          <span>Download on App Store</span>
        </a>
      </div>
    </div>

    <!-- Product Highlights Grid -->
    <div class="space-y-6">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Product Features
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {highlights.map((item) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80">
            <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">{item.title}</h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Pricing Matrix Component -->
    <PricingMatrix />
  </div>
</Layout>
