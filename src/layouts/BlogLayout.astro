---
// src/layouts/BlogLayout.astro
// Layout specifically for blog posts with reading progress, article schema, and TOC support
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: string;
  updatedDate?: string;
  readingTime?: string;
  tags?: string[];
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  readingTime = '5 min read',
  tags = [],
  slug,
} = Astro.props;

const siteUrl = 'https://harimoradiya.github.io';
const canonicalUrl = `${siteUrl}/blog/${slug}`;
const ogImage = `/og-blog-${slug}.png`;

const dateStr = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "url": canonicalUrl,
  "datePublished": pubDate,
  "dateModified": updatedDate || pubDate,
  "author": {
    "@type": "Person",
    "name": "Hari Moradiya",
    "url": siteUrl,
  },
  "publisher": {
    "@type": "Person",
    "name": "Hari Moradiya",
    "url": siteUrl,
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  "keywords": tags.join(', '),
};
---

<Layout
  title={`${title} | Hari Moradiya Blog`}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <!-- Reading progress bar -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <article class="blog-article" itemscope itemtype="https://schema.org/BlogPosting">
    <!-- Article header -->
    <header class="article-header">
      <div class="article-meta">
        <a href="/blog" class="back-to-blog">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          All Posts
        </a>
        <span class="meta-sep" aria-hidden="true">·</span>
        <time datetime={pubDate} itemprop="datePublished">{dateStr}</time>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span class="reading-time">⏱ {readingTime}</span>
      </div>

      <h1 class="article-title" itemprop="headline">{title}</h1>
      <p class="article-desc" itemprop="description">{description}</p>

      {tags.length > 0 && (
        <div class="article-tags" role="list" aria-label="Tags">
          {tags.map(tag => (
            <span class="chip chip-accent" role="listitem">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <!-- Article body -->
    <div class="article-body prose" itemprop="articleBody">
      <slot />
    </div>

    <!-- Article footer -->
    <footer class="article-footer">
      <div class="article-share">
        <p class="share-label">Share this post</p>
        <div class="share-btns">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalUrl)}&via=hari_moradiya_`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn"
            aria-label="Share on Twitter"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
            Twitter
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn"
            aria-label="Share on LinkedIn"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>

      <div class="related-cta">
        <a href="/projects/android-tv-remote" class="btn btn-primary">
          📺 Try the App — Android TV Remote
        </a>
        <a href="/blog" class="btn btn-secondary">
          ← More Articles
        </a>
      </div>
    </footer>
  </article>
</Layout>

<style>
  /* Reading progress bar */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    z-index: 2000;
    width: 0%;
    transition: width 0.1s linear;
  }

  /* Article layout */
  .blog-article {
    max-width: 780px;
    margin: 0 auto;
    padding-top: 1rem;
  }

  /* Header */
  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .back-to-blog {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .back-to-blog:hover { color: var(--primary-hover); }
  .meta-sep { color: var(--border-color); }

  .reading-time { font-weight: 500; }

  .article-title {
    font-size: clamp(1.85rem, 4.5vw, 2.75rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .article-desc {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Prose styles */
  .prose {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .prose :global(h2) {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 2rem 0 0.75rem;
    letter-spacing: -0.01em;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .prose :global(ul), .prose :global(ol) {
    margin: 1rem 0 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .prose :global(li) {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .prose :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-color: var(--primary-glow);
    transition: color 0.2s;
  }

  .prose :global(a:hover) { color: var(--primary-hover); }

  .prose :global(strong) {
    color: var(--text-primary);
    font-weight: 700;
  }

  .prose :global(code) {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 5px;
    padding: 0.15em 0.45em;
    font-size: 0.875em;
    color: var(--primary);
    font-family: 'Fira Code', 'Consolas', monospace;
  }

  .prose :global(pre) {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: var(--text-primary);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--primary);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: var(--primary-glow);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .prose :global(blockquote p) {
    color: var(--text-primary);
    font-style: italic;
    margin: 0;
  }

  .prose :global(img) {
    border-radius: var(--radius-lg);
    max-width: 100%;
    margin: 1.5rem 0;
    border: 1px solid var(--border-color);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 2.5rem 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .prose :global(th) {
    background: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 700;
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid var(--border-color);
  }

  .prose :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-secondary);
  }

  /* Footer */
  .article-footer {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .share-label {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .share-btns {
    display: flex;
    gap: 0.75rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .share-btn:hover {
    color: var(--primary);
    border-color: var(--primary);
    background: var(--primary-glow);
  }

  .related-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .related-cta { flex-direction: column; }
    .article-meta { gap: 0.5rem; }
  }
</style>

<script>
  // Reading progress bar
  const progressBar = document.getElementById('reading-progress');
  const article = document.querySelector('.article-body');

  if (progressBar && article) {
    window.addEventListener('scroll', () => {
      const articleTop = (article as HTMLElement).offsetTop;
      const articleHeight = (article as HTMLElement).offsetHeight;
      const scrolled = window.scrollY - articleTop;
      const progress = Math.min(100, Math.max(0, (scrolled / articleHeight) * 100));
      progressBar.style.width = `${progress}%`;
    }, { passive: true });
  }
</script>
