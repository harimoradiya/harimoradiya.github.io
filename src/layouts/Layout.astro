        gap: 0.75rem;
        margin-top: 1.25rem;
      }

      .social-btn {
        width: 38px;
        height: 38px;
        border-radius: var(--radius-md);
        background: var(--bg-base);
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.25s ease;
      }

      .social-btn:hover {
