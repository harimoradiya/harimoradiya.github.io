---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();

const links = [
  { label: 'GitHub', href: 'https://github.com/harimoradiya', external: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/hari-moradiya-0a7145179/', external: true },
  { label: 'Twitter', href: 'https://twitter.com/hari_moradiya_', external: true },
  { label: 'Privacy Policy', href: '/privacy-policy', external: false },
];
---

<footer class="mt-20 border-t border-zinc-200/80 dark:border-zinc-800/80 py-10 text-sm text-zinc-500 dark:text-zinc-400">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <span>&copy; {currentYear} Hari Moradiya.</span>
      <span class="text-zinc-300 dark:text-zinc-700">•</span>
      <span class="text-zinc-400 dark:text-zinc-500">Android & Mobile Systems Engineer</span>
    </div>

    <div class="flex items-center gap-5">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.external ? '_blank' : '_self'}
          rel={link.external ? 'noopener noreferrer' : undefined}
          class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</footer>
